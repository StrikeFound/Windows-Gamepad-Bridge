[DestinationDirs]
Files=13
[Files]
InputSessionClock.sys
WindowsGamepadBridge.sys
[SourceDisksNames]
1=%Provider%,,,
[SourceDisksFiles]
InputSessionClock.sys=1
WindowsGamepadBridge.sys=1
[Strings]
