[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
CatalogFile=WindowsGamepadBridgeControl.cat
DriverVer=10/24/2026,0.1.0.0
PnpLockdown=1
[Manufacturer]
%Provider%=Models,NTamd64.10.0...16299
[Models.NTamd64.10.0...16299]
%Name%=Control,ROOT\WindowsGamepadBridgeControl
[Control.NT]
CopyFiles=Files
[Control.NT.Services]
