AddService=WindowsGamepadBridgeDemoClock,0,TrialClockService
[Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\WindowsGamepadBridge.sys
[Control.NT.Wdf]
